# ==============================================================================
# Office OS Environment Configuration (.env.example)
# Copy to .env for local testing (Do NOT commit real secrets to Git)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=debug
APP_URL=http://localhost:8787

# Cloudflare Access Configuration (for authenticated employee requests)
# Set to 'false' during isolated unit testing or local development
CF_ACCESS_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_POLICY_AUD=your-access-aud-tag

# Google Workspace Integration (Domain-wide delegation or OAuth2)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_WORKSPACE_DOMAIN=yourcompany.com
GOOGLE_SCANS_DRIVE_FOLDER_ID=your-drive-folder-id

# Autonomy & System Limits
DEFAULT_AUTONOMY_LEVEL=L2
DAILY_AI_NEURON_BUDGET=10000
